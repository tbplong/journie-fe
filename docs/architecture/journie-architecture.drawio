<mxCell id="c121" value="&lt;b&gt;Current state (backend 7395b66)&lt;/b&gt;&lt;br&gt;Backend routes: /chat, /retrieval,&lt;br&gt;/routing, /routing/days, /health.&lt;br&gt;No auth, users or trips tables yet:&lt;br&gt;those features run on localStorage&lt;br&gt;through remoteOr() in the frontend.&lt;br&gt;/retrieval serves Ho Chi Minh City&lt;br&gt;(925 places in the test schema)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbea;strokeColor=#b7950b;strokeWidth=1.2;fontSize=11;fontColor=#1f2933;fontFamily=Helvetica;dashed=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="15" y="660" width="275" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>