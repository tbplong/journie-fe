# `npm run dev` already reads .env.development (VITE_API_URL=/api), so nothing is needed locally while the backend runs on :8000.
# Copy this file to .env.local (git ignores *.local) only to override a value, then restart `npm run dev`.

# Where the browser sends API calls (POST /chat reads the traveler's request with Gemini).
#   /api            use the dev-server proxy below; no CORS setup needed locally
#   https://...     a deployed backend; it must allow this site's origin (CORS)
#   (empty)         no backend: planning stops with "the AI server is not configured"
VITE_API_URL=/api

# Where the dev proxy forwards /api to (journie-be: `uv run fastapi dev app/main.py`).
BACKEND_URL=http://127.0.0.1:8000

# Ảnh địa điểm từ Google Maps qua ZioMap (ziomap.socibi.com). Chỉ máy chủ đọc biến này (vite.config.ts, api/place-photo.ts);
# không có tiền tố VITE_ nên trình duyệt không thấy. Trên Vercel: đặt trong Environment Variables.
ZIOMAP_API_KEY=
